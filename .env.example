# CloudSim Backend Environment Configuration

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Options: development, staging, production
CLOUDSIM_ENVIRONMENT=development

# Enable debug mode (disable in production)
CLOUDSIM_DEBUG=true

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://postgres:1@localhost:5432/cloudsim

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# IMPORTANT: Generate a secure key with: openssl rand -hex 32
# In production, this MUST be at least 32 characters!
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# ADMIN BOOTSTRAP
# =============================================================================
# Optional backend-only bootstrap for the first production admin.
# Do not expose these through Vite; VITE_* variables are public after build.
CLOUDSIM_BOOTSTRAP_ADMIN_ENABLED=false
# CLOUDSIM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# CLOUDSIM_BOOTSTRAP_ADMIN_PASSWORD=<set-in-your-host-secret-manager>
CLOUDSIM_BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# =============================================================================
# CORS & SECURITY
# =============================================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# =============================================================================
# AWS CONFIGURATION
# =============================================================================
# AWS_PROFILE=default

# AWS Region and Account
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=096615316348

# Use "mock" for public demos. Mock mode stores virtual instances in Postgres
# and never calls AWS EC2, CloudWatch, or Cost Explorer.
CLOUDSIM_AWS_BACKEND=live

# =============================================================================
# IAM ROLE-BASED ACCESS
# =============================================================================
# Enable role-based AWS access (users get different AWS permissions based on role)
ENABLE_ROLE_BASED_ACCESS=false

# IAM Role ARNs
# These roles must be created in AWS IAM with appropriate policies
# See docs/IAM_Setup_Guide.md for policy documentation

# AWS_ROLE_ADMIN=arn:aws:iam::096615316348:role/CloudSimAdminRole
# AWS_ROLE_DEVOPS=arn:aws:iam::096615316348:role/CloudSimDevOpsRole
# AWS_ROLE_READONLY=arn:aws:iam::096615316348:role/CloudSimUserRole

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Enable/disable Cost Explorer API (costs $0.01 per call)
ENABLE_COST_EXPLORER=false
